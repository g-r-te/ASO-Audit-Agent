# Required: LLM provider (OpenAI-compatible)
OPENAI_API_KEY=sk-...

# Optional: use NVIDIA NIM or another OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=nvidia/llama-3.1-70b-instruct

# Model id (with or without openai/ prefix). Examples: gpt-4o-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# Optional: Firecrawl for richer App Store page scraping (subtitle, keywords, promo text)
FIRECRAWL_API_KEY=fc-...
